# Engine configuration. Copy to engine/.env for local development. Never commit .env.

# Anthropic API key for handwriting reading, hypotheses and hint wording.
# Without it the engine runs in offline mode: typed steps, verification and built-in hints still work.
ANTHROPIC_API_KEY=
# Claude model id (default: claude-opus-5-5)
AI_MODEL=claude-opus-5-5
# Comma-separated browser origins allowed to call the API (only needed when the web app is served from another origin)
ALLOWED_ORIGINS=http://localhost:5173
# Optional Postgres (e.g. Neon) connection string. Unset = class mode disabled.
DATABASE_URL=
